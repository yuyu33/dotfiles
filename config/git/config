[init]
	defaultBranch = main
[core]
	editor = vim
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	colorMoved = default
[commit]
	verbose = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
# HTTPS auth via gh (follows ghsw / ghas)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# author for ~/dotfiles
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.config/git/config-yuyu33
# machine local (not tracked)
[include]
	path = ~/.config/git/config.local
